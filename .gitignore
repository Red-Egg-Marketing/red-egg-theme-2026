# ---------------------------------------------
#  Red Egg Marketing – WP Engine deployment
#  Repo root maps to the WordPress install root.
#  Only the theme is tracked. Compiled build assets
#  (style.css, blocks.editor.css, support/assets/js)
#  ARE committed so WP Engine serves them directly —
#  WP Engine does not run the webpack build.
# ---------------------------------------------

# Node dependencies (build tooling only — not needed on the server)
wp-content/themes/red-egg-theme-2026/support/node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
